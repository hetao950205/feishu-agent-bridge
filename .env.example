# ===== 飞书应用凭据（register.mjs 扫码创建后自动写入，也可手动填写） =====
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=replace-with-your-app-secret
# 国际版 Lark 填 lark；飞书（中国）留空
LARK_DOMAIN=

# ===== 机器人展示 =====
# 扫码创建时预设的应用名 / 简介，以及首次配对的自动回执
FEISHU_BOT_NAME=AI Agent
FEISHU_BOT_DESC=AI Agent 的飞书入口
FEISHU_PAIRING_ACK=已收到，AI Agent 会尽快回复你。

# ===== 本机接口 =====
# 只监听 127.0.0.1，此项只改端口
FEISHU_BRIDGE_PORT=8787
# /send 允许发送的本地文件目录（逗号分隔，默认已含本项目目录和 /tmp）
FEISHU_ALLOWED_FILE_DIRS=

# ===== 主人白名单 =====
# 主人 open_id（逗号分隔）。扫码人的 open_id 会写入 owner-open-id.txt，复制到这里。
# 留空 = 配对模式：所有人都视为主人，并对每个人的第一条私聊自动回执一次。
FEISHU_ALLOWED_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 唤醒上层智能体（可选） =====
# 收到消息后把整条 inbox 记录 POST 到此 URL
FEISHU_WAKE_URL=https://example.com/your-agent-webhook
FEISHU_WAKE_KEY=replace-with-your-webhook-key
# 密钥放在哪个请求头；为 Authorization 时自动加 "Bearer " 前缀
FEISHU_WAKE_KEY_HEADER=Authorization

# ===== 其他 =====
# 二维码 PNG 保存路径（默认本目录 feishu-qr.png）
FEISHU_QR_PNG=
# 二维码过期后自动重发的最大轮数
REGISTER_MAX_ROUNDS=6
# 非空则输出 DEBUG 日志
FEISHU_DEBUG=
# run-loop.sh 使用的 Node bin 目录（可选）
NODE_BIN=
# 休眠补拉：额外要补拉的 chat_id（逗号分隔，例如主人私聊会话）
FEISHU_CATCHUP_CHATS=
# 补拉间隔（毫秒）与首次回溯小时数
FEISHU_CATCHUP_INTERVAL_MS=120000
FEISHU_CATCHUP_FIRST_RUN_HOURS=6
